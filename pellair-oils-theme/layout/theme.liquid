<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags.first }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Google Fonts - Luxury Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Cormorant+Garamond:wght@300;400;500;600;700&family=Cinzel:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&family=Lato:wght@300;400;700&family=Raleway:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  {{ content_for_header }}

  <style>
    :root {
      --color-primary: {{ settings.color_primary }};
      --color-secondary: {{ settings.color_secondary }};
      --color-background: {{ settings.color_background }};
      --color-text: {{ settings.color_text }};
      --color-text-muted: {{ settings.color_text_muted }};
      --font-heading: '{{ settings.font_heading }}', serif;
      --font-body: '{{ settings.font_body }}', sans-serif;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: var(--font-body);
      background-color: var(--color-background);
      color: var(--color-text);
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* Luxury Typography */
    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-heading);
      font-weight: 600;
      letter-spacing: 0.05em;
      margin-bottom: 1rem;
      color: var(--color-text);
    }

    h1 { font-size: 3.5rem; line-height: 1.2; }
    h2 { font-size: 2.5rem; line-height: 1.3; }
    h3 { font-size: 1.8rem; }
    h4 { font-size: 1.4rem; }

    a {
      color: var(--color-secondary);
      text-decoration: none;
      transition: all 0.3s ease;
    }

    a:hover {
      color: var(--color-text);
    }

    /* Container */
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* Header Styles */
    .site-header {
      background: linear-gradient(180deg, rgba(13, 13, 13, 0.98) 0%, rgba(13, 13, 13, 0.95) 100%);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(201, 169, 97, 0.2);
      position: sticky;
      top: 0;
      z-index: 1000;
      padding: 1.5rem 0;
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .site-logo {
      font-family: var(--font-heading);
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--color-text);
      text-transform: uppercase;
      position: relative;
    }

    .site-logo::after {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 0;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, var(--color-secondary) 0%, transparent 100%);
    }

    /* Navigation */
    .main-nav {
      display: flex;
      gap: 2.5rem;
      align-items: center;
    }

    .main-nav a {
      font-size: 0.95rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text);
      position: relative;
      padding: 0.5rem 0;
    }

    .main-nav a::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 1px;
      background: var(--color-secondary);
      transition: width 0.3s ease;
    }

    .main-nav a:hover::before {
      width: 100%;
    }

    /* User Actions */
    .header-actions {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }

    .header-action-item {
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text);
      cursor: pointer;
      transition: color 0.3s ease;
    }

    .header-action-item:hover {
      color: var(--color-secondary);
    }

    .cart-count {
      background: var(--color-secondary);
      color: var(--color-primary);
      padding: 0.2rem 0.5rem;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 600;
      margin-left: 0.3rem;
    }

    /* Main Content */
    .main-content {
      min-height: 70vh;
      padding: 3rem 0;
    }

    /* Button Styles */
    .btn {
      display: inline-block;
      padding: 1rem 2.5rem;
      background: linear-gradient(135deg, var(--color-secondary) 0%, #b89654 100%);
      color: var(--color-primary);
      font-family: var(--font-body);
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border: none;
      cursor: pointer;
      transition: all 0.4s ease;
      position: relative;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(201, 169, 97, 0.3);
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.5s ease;
    }

    .btn:hover::before {
      left: 100%;
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(201, 169, 97, 0.4);
    }

    .btn-secondary {
      background: transparent;
      border: 2px solid var(--color-secondary);
      color: var(--color-secondary);
      box-shadow: none;
    }

    .btn-secondary:hover {
      background: var(--color-secondary);
      color: var(--color-primary);
    }

    /* Card Styles */
    .card {
      background: linear-gradient(145deg, rgba(26, 26, 26, 0.8) 0%, rgba(20, 20, 20, 0.9) 100%);
      border: 1px solid rgba(201, 169, 97, 0.15);
      border-radius: 8px;
      padding: 2rem;
      transition: all 0.4s ease;
      position: relative;
      overflow: hidden;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at top right, rgba(201, 169, 97, 0.05) 0%, transparent 70%);
      pointer-events: none;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: rgba(201, 169, 97, 0.4);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
    }

    /* Footer */
    .site-footer {
      background: linear-gradient(180deg, rgba(10, 10, 10, 0.95) 0%, rgba(5, 5, 5, 1) 100%);
      border-top: 1px solid rgba(201, 169, 97, 0.2);
      padding: 4rem 0 2rem;
      margin-top: 6rem;
    }

    .footer-content {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 3rem;
      margin-bottom: 3rem;
    }

    .footer-section h4 {
      font-size: 1.1rem;
      color: var(--color-secondary);
      margin-bottom: 1.5rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .footer-section ul {
      list-style: none;
    }

    .footer-section ul li {
      margin-bottom: 0.8rem;
    }

    .footer-section ul li a {
      color: var(--color-text-muted);
      font-size: 0.9rem;
      transition: color 0.3s ease;
    }

    .footer-section ul li a:hover {
      color: var(--color-secondary);
    }

    .footer-bottom {
      text-align: center;
      padding-top: 2rem;
      border-top: 1px solid rgba(201, 169, 97, 0.1);
      color: var(--color-text-muted);
      font-size: 0.85rem;
    }

    /* Ornamental Divider */
    .ornamental-divider {
      text-align: center;
      margin: 3rem 0;
      position: relative;
    }

    .ornamental-divider::before,
    .ornamental-divider::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 45%;
      height: 1px;
      background: linear-gradient(90deg, transparent 0%, var(--color-secondary) 50%, transparent 100%);
    }

    .ornamental-divider::before { left: 0; }
    .ornamental-divider::after { right: 0; }

    .ornamental-divider span {
      display: inline-block;
      color: var(--color-secondary);
      font-size: 1.5rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
      h1 { font-size: 2.5rem; }
      h2 { font-size: 2rem; }
      
      .header-inner {
        flex-direction: column;
        gap: 1rem;
      }

      .main-nav {
        flex-direction: column;
        gap: 1rem;
      }

      .container {
        padding: 0 1rem;
      }
    }

    /* Loading Animation */
    @keyframes shimmer {
      0% { background-position: -1000px 0; }
      100% { background-position: 1000px 0; }
    }

    /* Luxury Texture Overlay */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        radial-gradient(circle at 20% 50%, rgba(201, 169, 97, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(201, 169, 97, 0.03) 0%, transparent 50%);
      pointer-events: none;
      z-index: -1;
    }
  </style>

  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>

<body class="template-{{ template | replace: '.', '-' | handle }}">
  
  <!-- Header -->
  <header class="site-header">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="site-logo">Pellair Oils</a>
        
        <nav class="main-nav">
          <a href="/">Home</a>
          <a href="/collections/all">Collections</a>
          <a href="/collections/brands">Brands</a>
          <a href="/collections/accords">Accords</a>
          <a href="/pages/about">About</a>
          <a href="/pages/contact">Contact</a>
        </nav>

        <div class="header-actions">
          {% if customer %}
            <a href="/account" class="header-action-item">Account</a>
            <a href="/account/logout" class="header-action-item">Logout</a>
          {% else %}
            <a href="/account/login" class="header-action-item">Login</a>
            <a href="/account/register" class="header-action-item">Register</a>
          {% endif %}
          
          <a href="/cart" class="header-action-item">
            Cart
            <span class="cart-count" id="cart-count">{{ cart.item_count }}</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="main-content" role="main">
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-section">
          <h4>Pellair Oils</h4>
          <p style="color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.8;">
            Exclusive fragrance oils for discerning businesses. Inspired by the world's finest perfume houses.
          </p>
        </div>

        <div class="footer-section">
          <h4>Shop</h4>
          <ul>
            <li><a href="/collections/all">All Collections</a></li>
            <li><a href="/collections/brands">Shop by Brand</a></li>
            <li><a href="/collections/accords">Shop by Accord</a></li>
            <li><a href="/collections/new-arrivals">New Arrivals</a></li>
          </ul>
        </div>

        <div class="footer-section">
          <h4>Information</h4>
          <ul>
            <li><a href="/pages/about">About Us</a></li>
            <li><a href="/pages/b2b-registration">B2B Registration</a></li>
            <li><a href="/pages/quality-guarantee">Quality Guarantee</a></li>
            <li><a href="/pages/shipping">Shipping Information</a></li>
            <li><a href="/pages/contact">Contact Us</a></li>
          </ul>
        </div>

        <div class="footer-section">
          <h4>Customer Service</h4>
          <ul>
            <li><a href="/account">My Account</a></li>
            <li><a href="/account/orders">Order History</a></li>
            <li><a href="/pages/faq">FAQ</a></li>
            <li><a href="/pages/terms">Terms & Conditions</a></li>
            <li><a href="/pages/privacy">Privacy Policy</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; {{ 'now' | date: '%Y' }} Pellair Oils. All rights reserved. Exclusive B2B Fragrance Oils.</p>
      </div>
    </div>
  </footer>

  <script>
    // Update cart count dynamically
    function updateCartCount() {
      fetch('/cart.js')
        .then(response => response.json())
        .then(data => {
          document.getElementById('cart-count').textContent = data.item_count;
        });
    }

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  </script>

</body>
</html>
