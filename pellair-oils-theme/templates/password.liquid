<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} - Opening Soon</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
  
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Montserrat', sans-serif;
      background: #0d0d0d;
      color: #e8e8e8;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: 
        radial-gradient(circle at 30% 50%, rgba(201, 169, 97, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 70% 50%, rgba(201, 169, 97, 0.03) 0%, transparent 50%);
      pointer-events: none;
      z-index: 0;
    }

    .password-container {
      position: relative;
      z-index: 10;
      max-width: 600px;
      padding: 4rem 2rem;
      text-align: center;
    }

    .logo {
      font-family: 'Playfair Display', serif;
      font-size: 4rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 2rem;
      background: linear-gradient(135deg, #e8e8e8 0%, #c9a961 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .subtitle {
      font-size: 1.5rem;
      color: #999999;
      margin-bottom: 1rem;
      font-style: italic;
      font-family: 'Playfair Display', serif;
    }

    .message {
      font-size: 1.1rem;
      color: #999999;
      line-height: 1.8;
      margin-bottom: 3rem;
    }

    .ornamental-divider {
      text-align: center;
      margin: 2rem 0;
      position: relative;
    }

    .ornamental-divider::before,
    .ornamental-divider::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 40%;
      height: 1px;
      background: linear-gradient(90deg, transparent 0%, #c9a961 50%, transparent 100%);
    }

    .ornamental-divider::before { left: 0; }
    .ornamental-divider::after { right: 0; }

    .ornamental-divider span {
      display: inline-block;
      color: #c9a961;
      font-size: 1.5rem;
    }

    .password-form {
      background: linear-gradient(145deg, rgba(26, 26, 26, 0.8) 0%, rgba(20, 20, 20, 0.9) 100%);
      border: 1px solid rgba(201, 169, 97, 0.15);
      border-radius: 12px;
      padding: 3rem 2rem;
      margin: 2rem 0;
    }

    .password-form h2 {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      color: #c9a961;
      margin-bottom: 1.5rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .form-field {
      margin-bottom: 1.5rem;
    }

    .form-field input {
      width: 100%;
      padding: 1rem 1.5rem;
      background: rgba(26, 26, 26, 0.6);
      border: 1px solid rgba(201, 169, 97, 0.3);
      border-radius: 4px;
      color: #e8e8e8;
      font-family: 'Montserrat', sans-serif;
      font-size: 1rem;
      transition: all 0.3s ease;
    }

    .form-field input:focus {
      outline: none;
      border-color: #c9a961;
      box-shadow: 0 0 0 3px rgba(201, 169, 97, 0.1);
    }

    .btn {
      width: 100%;
      padding: 1.2rem;
      background: linear-gradient(135deg, #c9a961 0%, #b89654 100%);
      color: #1a1a1a;
      font-family: 'Montserrat', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.4s ease;
      box-shadow: 0 4px 15px rgba(201, 169, 97, 0.3);
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(201, 169, 97, 0.4);
    }

    .error-message {
      background: rgba(231, 76, 60, 0.15);
      border: 1px solid rgba(231, 76, 60, 0.3);
      color: #e74c3c;
      padding: 1rem;
      border-radius: 4px;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
    }

    .social-links {
      margin-top: 3rem;
    }

    .social-links p {
      color: #999999;
      margin-bottom: 1rem;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .social-icons {
      display: flex;
      gap: 1rem;
      justify-content: center;
    }

    .social-icon {
      width: 45px;
      height: 45px;
      border: 1px solid rgba(201, 169, 97, 0.3);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #c9a961;
      transition: all 0.3s ease;
      text-decoration: none;
    }

    .social-icon:hover {
      background: rgba(201, 169, 97, 0.2);
      border-color: #c9a961;
      transform: translateY(-3px);
    }

    .admin-link {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      color: #666;
      font-size: 0.85rem;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .admin-link:hover {
      color: #c9a961;
    }

    @media (max-width: 768px) {
      .logo {
        font-size: 2.5rem;
      }

      .subtitle {
        font-size: 1.2rem;
      }

      .password-form {
        padding: 2rem 1.5rem;
      }

      .password-container {
        padding: 2rem 1rem;
      }
    }
  </style>
</head>

<body>
  <div class="password-container">
    
    <h1 class="logo">{{ shop.name }}</h1>
    <p class="subtitle">{{ 'general.password_page.opening_soon' | t }}</p>
    
    <p class="message">
      Pellair Oils is an exclusive B2B platform for luxury fragrance oils, inspired by the world's finest perfume houses. We're currently preparing our exclusive collection for business partners.
    </p>

    <div class="ornamental-divider">
      <span>❖</span>
    </div>

    {% if shop.password_message != blank %}
      <div style="background: rgba(201, 169, 97, 0.1); border: 1px solid rgba(201, 169, 97, 0.3); padding: 1.5rem; border-radius: 8px; margin: 2rem 0;">
        {{ shop.password_message }}
      </div>
    {% endif %}

    <div class="password-form">
      <h2>Enter Password</h2>
      
      {% form 'storefront_password' %}
        {% if form.errors %}
          <div class="error-message">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="form-field">
          <input
            type="password"
            name="password"
            placeholder="Enter store password"
            autofocus
          >
        </div>

        <button type="submit" class="btn">Enter</button>
      {% endform %}
    </div>

    {% if shop.password_message == blank %}
      <p class="message" style="margin-top: 2rem; font-size: 0.95rem;">
        Are you a business partner? Contact us for early access to our exclusive collection.
      </p>
    {% endif %}

    <!-- Social Links (Optional) -->
    <div class="social-links">
      <p>Follow Us</p>
      <div class="social-icons">
        {% if settings.social_facebook_link != blank %}
          <a href="{{ settings.social_facebook_link }}" class="social-icon" target="_blank" aria-label="Facebook">f</a>
        {% endif %}
        {% if settings.social_instagram_link != blank %}
          <a href="{{ settings.social_instagram_link }}" class="social-icon" target="_blank" aria-label="Instagram">📷</a>
        {% endif %}
        {% if settings.social_twitter_link != blank %}
          <a href="{{ settings.social_twitter_link }}" class="social-icon" target="_blank" aria-label="Twitter">🐦</a>
        {% endif %}
      </div>
    </div>

  </div>

  <a href="/admin" class="admin-link">Store owner? Log in here</a>

</body>
</html>
