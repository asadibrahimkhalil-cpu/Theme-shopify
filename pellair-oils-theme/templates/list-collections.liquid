<div class="container">
  
  <div class="collections-header">
    <h1>All Collections</h1>
    <p>Explore our curated selections of luxury fragrance oils</p>
  </div>

  <div class="collections-grid">
    {% for collection in collections %}
      {% unless collection.handle == 'frontpage' %}
        <a href="{{ collection.url }}" class="collection-card card">
          {% if collection.image %}
            <div class="collection-image">
              <img src="{{ collection.image | img_url: 'large' }}" alt="{{ collection.title | escape }}">
            </div>
          {% endif %}
          
          <div class="collection-info">
            <h3>{{ collection.title }}</h3>
            {% if collection.description != blank %}
              <p>{{ collection.description | strip_html | truncate: 120 }}</p>
            {% endif %}
            <div class="collection-count">{{ collection.products_count }} products</div>
          </div>
        </a>
      {% endunless %}
    {% endfor %}
  </div>

</div>

<style>
  .collections-header {
    text-align: center;
    margin: 3rem 0;
  }

  .collections-header h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .collections-header p {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    margin: 3rem 0;
  }

  .collection-card {
    padding: 0;
    overflow: hidden;
    cursor: pointer;
  }

  .collection-image {
    width: 100%;
    height: 250px;
    overflow: hidden;
  }

  .collection-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .collection-card:hover .collection-image img {
    transform: scale(1.1);
  }

  .collection-info {
    padding: 2rem;
  }

  .collection-info h3 {
    font-size: 1.5rem;
    color: var(--color-secondary);
    margin-bottom: 0.8rem;
  }

  .collection-info p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .collection-count {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .collections-grid {
      grid-template-columns: 1fr;
    }

    .collections-header h1 {
      font-size: 2rem;
    }
  }
</style>
